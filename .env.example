# ─────────────────────────────────────────────────────────────
# SignFlow environment variables
# Copy to .env.local for local development.
# Everything is optional for local testing:
#   - Without Supabase vars → data is stored in ./.data (local JSON DB + files)
#   - Without email vars    → emails/OTP codes are printed to the server console
#                             and the OTP is shown on screen (development only)
# ─────────────────────────────────────────────────────────────

# Public base URL used in emailed links (auto-detected from request if empty)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used for HMAC hash seals and signing-session cookies.
# Generate: openssl rand -base64 48
APP_SECRET=

# ── Supabase (server-side only; never expose the service role key) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# ── Email: choose Resend OR SMTP (Resend wins if both are set) ──
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="SignFlow <no-reply@example.com>"

# ── Optional X.509 / PKCS#12 certificate for a cryptographic PDF signature ──
# base64 -w0 certificate.p12
SIGNING_P12_BASE64=
SIGNING_P12_PASSPHRASE=
SIGNING_REASON="Document sealed by SignFlow"
SIGNING_LOCATION="SignFlow Cloud"
SIGNING_CONTACT=

# ── Vercel Cron protection (Vercel sends: Authorization: Bearer $CRON_SECRET) ──
CRON_SECRET=
